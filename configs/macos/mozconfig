ac_add_options --target=aarch64-apple-darwin

# Firefox's own test harnesses are not used here and cost real build time.
ac_add_options --disable-tests

# Surfer appends a build-mode block after this file. The default mode is `dev`,
# which supplies --disable-debug on its own; switch with
#   npx surfer set buildMode [dev|debug|release]
#
# Everything below is release-only. Keeping it gated is why a local build stays
# quick — attempt #1 applied these unconditionally and taxed every dev build.
if test "$KOI_RELEASE"; then
  ac_add_options --enable-release
  ac_add_options --enable-optimize
  ac_add_options --enable-hardening
  ac_add_options --enable-rust-simd
  ac_add_options --enable-wasm-simd
  ac_add_options --disable-debug
  ac_add_options --disable-debug-symbols
  ac_add_options --disable-debug-js-modules
  ac_add_options --enable-updater

  export MOZ_LTO=cross,thin
  ac_add_options --enable-lto=cross,thin

  # Clang defaults to -mcpu=apple-a7 for aarch64-apple-darwin, which switches
  # off most Apple-silicon performance features.
  export CFLAGS="$CFLAGS -mcpu=apple-m1"
  export CXXFLAGS="$CXXFLAGS -mcpu=apple-m1"

  mk_add_options MOZILLA_OFFICIAL=1
  export MOZILLA_OFFICIAL=1
fi
