ac_add_options --target=aarch64-apple-darwin

# Firefox's test harnesses are unused here and cost build time.
ac_add_options --disable-tests

# Surfer appends a build-mode block after this file; the default `dev` mode
# supplies --disable-debug. Switch with `npx surfer set buildMode
# [dev|debug|release]`.
#
# Release-only, gated by $KOI_RELEASE so local builds stay fast.
if test "$KOI_RELEASE"; then
  # Its own objdir, so a release build leaves the dev build alone. Not obj-*:
  # surfer warns when it finds two.
  mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/objdir-release

  ac_add_options --enable-release
  ac_add_options --enable-optimize
  ac_add_options --enable-hardening
  ac_add_options --enable-rust-simd
  ac_add_options --disable-debug
  ac_add_options --disable-debug-symbols
  ac_add_options --disable-debug-js-modules
  ac_add_options --enable-updater

  export MOZ_LTO=cross,thin
  ac_add_options --enable-lto=cross,thin

  # Clang's aarch64-apple-darwin default, apple-a7, leaves out most
  # Apple-silicon performance features.
  export CFLAGS="$CFLAGS -mcpu=apple-m1"
  export CXXFLAGS="$CXXFLAGS -mcpu=apple-m1"

  mk_add_options MOZILLA_OFFICIAL=1
  export MOZILLA_OFFICIAL=1

  # Safe Browsing (phishing and malware warnings) needs Koi's own Google key;
  # without it the protection is silently off. Kept out of the repo.
  if test -f "$HOME/.koi-keys/safebrowsing.dat"; then
    ac_add_options --with-google-safebrowsing-api-keyfile="$HOME/.koi-keys/safebrowsing.dat"
  fi
else
  # A dev build is offered every release (same channel, update.koi.surf), and
  # applying one would overwrite the objdir's app, so it has no updater.
  ac_add_options --disable-updater
fi
