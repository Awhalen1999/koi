#
# Merged by `surfer build` into engine/mozconfig, in this order:
#   configs/common + configs/<os> + optional untracked ./mozconfig + surfer's
#   internal block (branding, update channel, MAR ids, MOZ_APPUPDATE_HOST).
# Never edit engine/mozconfig directly — it is generated output.
#
# ${binName} and ${changeset} are substituted by surfer from surfer.json.

ac_add_options --enable-application=browser

# Identity ---------------------------------------------------------------
ac_add_options --with-app-name=${binName}

# Capitalised: this becomes application.ini's Name and the macOS profile
# directory (~/Library/Application Support/Koi).
export MOZ_APP_BASENAME=Koi

# The macOS bundle id is composed by toolkit/moz.configure as
#   {distribution-id}.{surfer.json appId}
# giving surf.koi.browser. This must be the configure option; exporting
# MOZ_DISTRIBUTION_ID is ignored.
ac_add_options --with-distribution-id=surf.koi

# MOZ_APP_VENDOR and MOZ_APP_UA_NAME are implied-only configure options
# (possible_origins=("implied",)) and are a hard configure error if exported
# here. They live in src/browser/moz-configure.patch and
# src/toolkit/moz-configure.patch instead.

# Source info, surfaced in about:buildconfig
export MOZ_INCLUDE_SOURCE_INFO=1
export MOZ_SOURCE_REPO=https://github.com/Awhalen1999/koi
export MOZ_SOURCE_CHANGESET=${changeset}

# Privacy ----------------------------------------------------------------
# Firefox defaults phone home; a fork has to switch each off explicitly.

# Both forms are required. mk_add_options only reaches make, so configure
# would otherwise keep Firefox's default.
mk_add_options MOZ_TELEMETRY_REPORTING=
ac_add_options MOZ_TELEMETRY_REPORTING=

# MOZ_DATA_REPORTING cannot be set here: toolkit/moz.configure derives it from
# telemetry, healthreport, crashreporter and normandy. Telemetry and the crash
# reporter are off here, the other two in src/browser/moz-configure.patch;
# with all four off it disappears.

# Koi has no crash service; left on, reports go to crash-reports.mozilla.com
# under Firefox's app GUID.
ac_add_options --disable-crashreporter

# Mozilla's add-on signing does not cover this build.
export MOZ_REQUIRE_SIGNING=
mk_add_options MOZ_REQUIRE_SIGNING=
ac_add_options --with-unsigned-addon-scopes=app,system

# Build ------------------------------------------------------------------
ac_add_options --enable-bootstrap

# Configure changes can leave stale generated bindings that fail the next
# incremental build; let mach clobber itself.
mk_add_options AUTOCLOBBER=1

# sccache is bootstrapped into ~/.mozbuild, not on PATH at configure time.
if test -x "$(command -v sccache)"; then
  ac_add_options --with-ccache=sccache
elif test -f "$HOME/.mozbuild/sccache/sccache"; then
  ac_add_options --with-ccache="$HOME"/.mozbuild/sccache/sccache
fi

# MOZ_MAKE_FLAGS is intentionally unset so mach uses every core. Add
# mk_add_options MOZ_MAKE_FLAGS="-jN" to an untracked ./mozconfig to throttle.
