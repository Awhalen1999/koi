# Reached from browser/base/moz.build via `DIRS += ["../../koi"]`.
#
# A feature directory only belongs in DIRS if it has its own moz.build, i.e.
# it ships JS modules through EXTRA_JS_MODULES. Directories that are purely
# content (CSS, images) need nothing here — they are registered through
# jar.inc.mn instead. See src/browser/base/content/koi-assets.jar.inc.mn.

DIRS += []
