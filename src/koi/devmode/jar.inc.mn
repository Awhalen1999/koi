# Included from browser/base/jar.mn, so source paths are relative to
# browser/base/. See src/koi/common/jar.inc.mn for the ground rules
# (no bare `*` flag, `%` is the preprocessor marker in .css).
#
# The two .sys.mjs files are a window actor's modules, loaded by URL in the
# parent and in content processes alike (KoiDevMode.sys.mjs).

        content/browser/koi-devmode/koi-devmode.css             (../../koi/devmode/koi-devmode.css)
        content/browser/koi-devmode/koi-devmode.js              (../../koi/devmode/koi-devmode.js)
        content/browser/koi-devmode/KoiDevMode.sys.mjs          (../../koi/devmode/KoiDevMode.sys.mjs)
        content/browser/koi-devmode/KoiPageErrorsChild.sys.mjs  (../../koi/devmode/KoiPageErrorsChild.sys.mjs)
