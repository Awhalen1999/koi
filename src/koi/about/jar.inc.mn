# Included through koi-assets.jar.inc.mn into browser/base/jar.mn, so source
# paths are relative to browser/base/. Rules: src/koi/common/jar.inc.mn.
#
# about:rights can load these from a content process because browser/base's
# jar.mn declares `content browser` contentaccessible=yes.

        content/browser/koi-about/koi-rights.html               (../../koi/about/koi-rights.html)
        content/browser/koi-about/koi-rights.css                (../../koi/about/koi-rights.css)
        content/browser/koi-about/koi-private.html              (../../koi/about/koi-private.html)
        content/browser/koi-about/koi-private.css               (../../koi/about/koi-private.css)
        content/browser/koi-about/koi-private.js                (../../koi/about/koi-private.js)
        content/browser/koi-about/koi-private-ghost.svg          (../../koi/about/koi-private-ghost.svg)
