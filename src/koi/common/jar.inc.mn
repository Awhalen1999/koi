# Included from browser/base/jar.mn, so source paths are relative to
# browser/base/. `../../koi/` is engine/koi/, which is a symlink farm pointing
# back at src/koi/.
#
# A leading `*` runs the file through the mozbuild preprocessor. Only add it to
# a file that actually contains directives — jar.py calls failUnused() and the
# build dies with "no preprocessor directives found" otherwise. Note the marker
# in .css files is `%`, not `#`, so it is `%include`, `%ifdef` and so on.

        content/browser/koi-styles/koi-theme.css                (../../koi/common/styles/koi-theme.css)
        content/browser/koi-styles/koi-shell.css                (../../koi/common/styles/koi-shell.css)
        content/browser/koi-common/koi-mark.svg                 (../../koi/common/assets/koi-mark.svg)
