# Included through koi-assets.jar.inc.mn into browser/base/jar.mn, so source
# paths are relative to browser/base/; ../../koi/ is engine/koi/, symlinks
# into src/koi/.
#
# A leading `*` preprocesses a file and requires it to contain directives:
# jar.py fails the build with "no preprocessor directives found" otherwise.
# In .css the directive marker is `%` (`%include`), not `#`.

        content/browser/koi-styles/koi-theme.css                (../../koi/common/styles/koi-theme.css)
        content/browser/koi-styles/koi-shell.css                (../../koi/common/styles/koi-shell.css)
        content/browser/koi-styles/koi-outline.css              (../../koi/common/styles/koi-outline.css)
        content/browser/koi-common/koi-mark.svg                 (../../koi/common/assets/koi-mark.svg)
        content/browser/koi-common/koi-board.svg                (../../koi/common/assets/koi-board.svg)
