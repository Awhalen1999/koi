+#---------------------------------------------------------------------------
+# Prefs starting with "koi."
+#---------------------------------------------------------------------------
+
+# Draw browser windows with macOS vibrancy, so the desktop shows through the
+# chrome. Koi's chrome has no colour of its own — this is what gives it the
+# user's wallpaper. Has no effect off macOS.
+- name: koi.widget.macos.window-vibrancy
+  type: bool
+  value: true
+  mirror: always
+
+# Which NSVisualEffectMaterial backs the window. The material decides the blur,
+# so it is most of the look. Mapping in KoiWindowMaterial(),
+# widget/cocoa/nsCocoaWindow.mm:
+#   1 HUD window (default)   5 tooltip
+#   2 full screen UI         6 header view
+#   3 popover                7 under-window background
+#   4 menu
+- name: koi.widget.macos.window-material
+  type: uint32_t
+  value: 1
+  mirror: always
+
